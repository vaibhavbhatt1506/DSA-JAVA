import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class MergeIntervals {

    public static int[][] merge(int[][] intervals) {
        if (intervals.length <= 1) {
            return intervals;
        }

        // 1. Sort the intervals by their start time
        // We use a custom lambda comparator here
        Arrays.sort(intervals, (a, b) -> Integer.compare(a[0], b[0]));

        List<int[]> merged = new ArrayList<>();
        
        // Add the first interval to our list to start comparisons
        int[] currentInterval = intervals[0];
        merged.add(currentInterval);

        for (int[] interval : intervals) {
            int currentEnd = currentInterval[1];
            
            int nextStart = interval[0];
            int nextEnd = interval[1];

            // 2. Check for overlap
            if (currentEnd >= nextStart) {
                // Overlap exists: update the end of the current interval
                // We use Math.max because a later interval might be completely inside an earlier one (e.g. [1,5] and [2,4])
                currentInterval[1] = Math.max(currentEnd, nextEnd);
            } else {
                // No overlap: the current interval is finalized. 
                // Add the new interval to the list and make it the new 'current'
                currentInterval = interval;
                merged.add(currentInterval);
            }
        }

        // Convert the dynamic List back to a static 2D array
        return merged.toArray(new int[merged.size()][]);
    }

    public static void main(String[] args) {
        int[][] intervals = {{1, 3}, {8, 10}, {2, 6}, {15, 18}};
        
        System.out.println("Original Intervals:");
        for (int[] interval : intervals) System.out.print(Arrays.toString(interval) + " ");
        
        int[][] result = merge(intervals);
        
        System.out.println("\n\nMerged Intervals:");
        for (int[] interval : result) System.out.print(Arrays.toString(interval) + " ");
    }
}
