class Solution:
    def maxProfit(self, prices: list[int]) -> int:
        # Start with the maximum possible integer value
        min_price = float('inf')
        max_profit = 0
        
        for price in prices:
            # Update min_price if we find a cheaper day to buy
            if price < min_price:
                min_price = price
            # Otherwise, check if selling today yields a higher profit
            elif price - min_price > max_profit:
                max_profit = price - min_price
                
        return max_profit
