public class BlockSwapRotation {

    // Main function to initiate the rotation
    public static void leftRotate(int[] arr, int d, int n) {
        // Handle cases where d >= n
        d = d % n; 
        if (d == 0) return;
        
        leftRotateRec(arr, 0, d, n);
    }

    // Recursive function for block swap
    private static void leftRotateRec(int[] arr, int i, int d, int n) {
        // Base cases
        if (d == 0 || d == n) return;

        // If block sizes are equal, swap them and we are done
        if (n - d == d) {
            swap(arr, i, n - d + i, d);
            return;
        }

        // If A is shorter
        if (d < n - d) {
            swap(arr, i, n - d + i, d);
            leftRotateRec(arr, i, d, n - d);
        } 
        // If B is shorter
        else {
            swap(arr, i, d, n - d);
            leftRotateRec(arr, n - d + i, 2 * d - n, d);
        }
    }

    // Utility function to swap a block of 'd' elements 
    // starting at index 'fi' with a block starting at index 'si'
    private static void swap(int[] arr, int fi, int si, int d) {
        for (int i = 0; i < d; i++) {
            int temp = arr[fi + i];
            arr[fi + i] = arr[si + i];
            arr[si + i] = temp;
        }
    }

    // Main method to test the algorithm
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5, 6, 7};
        int d = 2; // Number of rotations
        int n = arr.length;

        System.out.println("Original Array:");
        printArray(arr);

        leftRotate(arr, d, n);

        System.out.println("\nArray after " + d + " left rotations:");
        printArray(arr);
    }

    // Helper method to print the array
    private static void printArray(int[] arr) {
        for (int j : arr) {
            System.out.print(j + " ");
        }
        System.out.println();
    }
}
