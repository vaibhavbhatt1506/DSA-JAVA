public class KokoEatingBananas {

    public static int minEatingSpeed(int[] piles, int h) {
        int left = 1;
        int right = 1;
        
        // Find the maximum pile to set our upper bound
        for (int pile : piles) {
            right = Math.max(right, pile);
        }

        // Apply Binary Search on the answer
        while (left < right) {
            int mid = left + (right - left) / 2;
            
            // If Koko can eat all bananas at speed 'mid'
            if (canEatInTime(piles, mid, h)) {
                // Try a slower speed
                right = mid; 
            } else {
                // Too slow, must eat faster
                left = mid + 1; 
            }
        }

        return left;
    }

    // Helper function to check if a given speed 'k' is valid
    private static boolean canEatInTime(int[] piles, int k, int h) {
        int hours = 0;
        for (int pile : piles) {
            // Equivalent to Math.ceil((double)pile / k) but avoids floating point math
            hours += (pile + k - 1) / k; 
        }
        return hours <= h;
    }

    public static void main(String[] args) {
        int[] piles = {3, 6, 7, 11};
        int h = 8;
        
        System.out.println("Minimum eating speed: " + minEatingSpeed(piles, h)); // Output: 4
    }
}
