class Solution {
    public int[] getConcatenation(int[] nums) {
        int n = nums.length;
        int[] ans = new int[2 * n];
        
        // Copy nums into ans starting at index 0
        System.arraycopy(nums, 0, ans, 0, n);
        // Copy nums into ans starting at index n
        System.arraycopy(nums, 0, ans, n, n);
        
        return ans;
    }
}
