public class TrappingRainWater {

    public static int trap(int[] height) {
        if (height == null || height.length == 0) {
            return 0;
        }

        int left = 0;
        int right = height.length - 1;
        
        int left_max = 0;
        int right_max = 0;
        
        int totalWater = 0;

        while (left < right) {
            // The water level is dictated by the smaller of the two outer boundaries
            if (height[left] < height[right]) {
                if (height[left] >= left_max) {
                    // We found a new, taller boundary on the left. No water can be trapped here.
                    left_max = height[left];
                } else {
                    // The current bar is shorter than the max on its left, and we know there 
                    // is an even taller bar somewhere on its right. Water is trapped!
                    totalWater += left_max - height[left];
                }
                left++; // Move the left pointer inward
                
            } else { // height[left] >= height[right]
                if (height[right] >= right_max) {
                    // We found a new, taller boundary on the right.
                    right_max = height[right];
                } else {
                    // Water is trapped!
                    totalWater += right_max - height[right];
                }
                right--; // Move the right pointer inward
            }
        }

        return totalWater;
    }

    public static void main(String[] args) {
        int[] elevationMap = {0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1};
        System.out.println("Total water trapped: " + trap(elevationMap)); // Output: 6
    }
}
