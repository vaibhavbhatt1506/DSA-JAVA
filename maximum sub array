public class MaxSumSubarray {

    public static int findMaxSum(int[] arr, int k) {
        if (arr == null || arr.length < k || k <= 0) return 0;

        int windowSum = 0;
        int maxSum = 0;

        // Step 1: Calculate the sum of the first window
        for (int i = 0; i < k; i++) {
            windowSum += arr[i];
        }
        maxSum = windowSum;

        // Step 2: Slide the window from index k to the end
        for (int i = k; i < arr.length; i++) {
            // Subtract the element that left the window, add the new element
            windowSum = windowSum - arr[i - k] + arr[i];
            maxSum = Math.max(maxSum, windowSum);
        }

        return maxSum;
    }

    public static void main(String[] args) {
        int[] arr = {2, 1, 5, 1, 3, 2};
        int k = 3;
        System.out.println("Maximum sum of a subarray of size " + k + ": " + findMaxSum(arr, k));
    }
}
