public class RedundantConnection {

    // Internal class to encapsulate the Union-Find logic
    static class UnionFind {
        int[] parent;

        public UnionFind(int n) {
            parent = new int[n + 1];
            // Initially, every node is its own parent
            for (int i = 1; i <= n; i++) {
                parent[i] = i;
            }
        }

        // The "Find" function with Path Compression
        public int find(int node) {
            if (parent[node] == node) {
                return node; // We found the root
            }
            // Path Compression: Make the tree flat by pointing directly to the root
            parent[node] = find(parent[node]);
            return parent[node];
        }

        // The "Union" function. Returns false if they are already connected.
        public boolean union(int node1, int node2) {
            int root1 = find(node1);
            int root2 = find(node2);

            // If they have the same root, a cycle is detected!
            if (root1 == root2) {
                return false; 
            }

            // Otherwise, merge the sets (make root1 the parent of root2)
            parent[root2] = root1;
            return true;
        }
    }

    public static int[] findRedundantConnection(int[][] edges) {
        // The number of nodes is equal to the number of edges 
        // (since a valid tree has N-1 edges, and we have 1 extra)
        int n = edges.length;
        UnionFind uf = new UnionFind(n);

        for (int[] edge : edges) {
            // Try to union the two nodes. If it returns false, it's redundant.
            if (!uf.union(edge[0], edge[1])) {
                return edge;
            }
        }

        return new int[0];
    }

    public static void main(String[] args) {
        int[][] edges = {{1, 2}, {1, 3}, {2, 3}};
        int[] result = findRedundantConnection(edges);
        System.out.println("Redundant Edge: [" + result[0] + ", " + result[1] + "]"); 
        // Output: [2, 3]
    }
}
